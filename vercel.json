{
  "buildCommand": "node scripts/build.mjs",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://*.supabase.co; connect-src 'self' https://*.supabase.co wss://*.supabase.co; frame-src https://www.google.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" }
      ]
    },
    { "source": "/js/(.*)","headers": [{ "key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=86400" }] },
    { "source": "/css/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=86400" }] },
    { "source": "/img/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }] }
  ],
  "functions": {
    "api/sugerir-descricao.js": { "maxDuration": 30 }
  },
  "trailingSlash": false,
  "redirects": [
    { "source": "/fornecedores/bras", "destination": "/regiao/bras", "permanent": true },
    { "source": "/fornecedores/bom-retiro", "destination": "/regiao/bom-retiro", "permanent": true },
    { "source": "/fornecedores/25-de-marco", "destination": "/regiao/25-de-marco", "permanent": true },
    { "source": "/fornecedores/pari", "destination": "/regiao/pari", "permanent": true }
  ],
  "rewrites": [
    { "source": "/admin/:path*", "destination": "/admin/index.html" },
    { "source": "/fornecedor/:slug", "destination": "/index.html" },
    { "source": "/categorias/:slug", "destination": "/index.html" },
    { "source": "/regiao/:slug", "destination": "/index.html" }
  ]
}
